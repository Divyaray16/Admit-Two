# Leave both blank to store invitations on the local app server (data/invitations).
# Share links then work for anyone who can open that server.
# To use Supabase instead, create a project, run supabase/schema.sql, and set
# both values. Never use the service role key.
#
# On Vercel, add both variables to Production and to Preview. Preview deployments
# do not receive Production-only variables. Vite inlines VITE_ values at build
# time, so change them and redeploy; a static deploy cannot fall back to /api/invitations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
